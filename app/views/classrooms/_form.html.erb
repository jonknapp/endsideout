<%= form_with(model: classroom, url: url) do |form| %>
  <div class="flex flex-col gap-2">
  <% if classroom.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(classroom.errors.count, "error") %> prohibited this classroom from being saved:</h2>

      <ul>
        <% classroom.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, class: "input w-full" %>

    <%= form.label :teacher_id, "Teacher", class: "label" %>
  <%= form.collection_select :teacher_id, teachers, :id, :name, { include_blank: "Select a teacher" }, class: "select w-full" %>

    <div class="flex flex-col gap-1">
      <span class="label">Programs</span>
      <%= form.fields_for :classroom_programs do |cp_form| %>
        <% enrolled = cp_form.object.persisted? %>
        <div class="flex items-center gap-3" data-controller="program-enrollment">
          <%= cp_form.hidden_field :program_id %>
          <%= cp_form.hidden_field :_destroy, value: enrolled ? "0" : "1", data: { program_enrollment_target: "destroy" } %>
          <label class="flex items-center gap-2 cursor-pointer">
            <%= tag.input type: "checkbox", class: "checkbox checkbox-primary",
                          checked: enrolled,
                          autocomplete: "off",
                          data: { action: "change->program-enrollment#toggle" } %>
            <span class="label"><%= cp_form.object.program.name %></span>
          </label>
          <%= tag.div data: { program_enrollment_target: "levelSection" },
                      style: ("display:none" unless enrolled) do %>
            <%= cp_form.select :level,
                  ClassroomProgram.levels.keys.map { |l| [l.humanize, l] },
                  { include_blank: "Select level", selected: cp_form.object.level },
                  class: "select select-bordered select-sm" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if classroom.persisted? %>
      <%= form.label :Link, class: "label" %>
      <%= link_to classroom_roster_url(classroom.uuid), classroom_roster_path(classroom.uuid), class: 'link' %>
    <% end %>

    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
